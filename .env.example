# WalletConnect (optional)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Escrow contract on Ethereum mainnet (required for on-chain swap)
# Set in Cloudflare Pages → Settings → Environment variables (build time)
NEXT_PUBLIC_SWAP_CONTRACT=

# Deploy script only — NEVER commit .env with real keys
DEPLOYER_PRIVATE_KEY=
ETH_RPC_URL=https://eth.llamarpc.com
