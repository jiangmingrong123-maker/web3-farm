# WalletConnect (optional)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Escrow contract on Ethereum mainnet (required for on-chain swap)
# Set in Cloudflare Pages → Settings → Environment variables (build time)
NEXT_PUBLIC_SWAP_CONTRACT=

# Optional — mainnet RPC for NFT verify + wallet reads (browser CORS-safe)
# NEXT_PUBLIC_ETH_RPC_URL=https://ethereum.publicnode.com

# Deploy script only — NEVER commit .env with real keys
DEPLOYER_PRIVATE_KEY=
# Optional — script tries several public RPCs if unset
# ETH_RPC_URL=https://ethereum.publicnode.com
# Or get a free key: https://www.alchemy.com or https://infura.io
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
